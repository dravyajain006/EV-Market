datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         String      @default("VIEWER") // ADMIN, ANALYST, VIEWER
  department   String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  datasets     Dataset[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model DimRegion {
  id               String               @id @default(cuid())
  stateCode        String               @unique
  stateName        String
  zone             String
  capital          String?
  evPolicyActive   Boolean              @default(true)
  evRegistrations  FactEvRegistration[]
  chargingStations FactChargingStation?
}

model DimCategory {
  id                   String                    @id @default(cuid())
  categoryCode         String                    @unique // 2W, 3W, 4W, BUS, COMMERCIAL
  categoryName         String
  description          String?
  fameSubsidyEligible  Boolean                   @default(true)
  evRegistrations      FactEvRegistration[]
  manufacturerRankings FactManufacturerRanking[]
}

model DimManufacturer {
  id            String                    @id @default(cuid())
  name          String                    @unique
  category      String
  originCountry String
  headquarters  String?
  isIndianOEM   Boolean                   @default(true)
  foundedYear   Int?
  rankings      FactManufacturerRanking[]
}

model FactEvRegistration {
  id                         String      @id @default(cuid())
  regionId                   String
  region                     DimRegion   @relation(fields: [regionId], references: [id])
  categoryId                 String
  category                   DimCategory @relation(fields: [categoryId], references: [id])
  year                       Int
  month                      Int?        @default(12)
  evRegistrations            Int
  totalVehicleRegistrations  Int
  evPenetrationPct           Float
  yoyGrowthPct               Float?
  dataSource                 String      @default("VAHAN_PUBLIC_DASHBOARD")
  createdAt                  DateTime    @default(now())

  @@unique([regionId, categoryId, year])
  @@index([year])
  @@index([regionId])
  @@index([categoryId])
}

model FactManufacturerRanking {
  id                  String          @id @default(cuid())
  manufacturerId      String
  manufacturer        DimManufacturer @relation(fields: [manufacturerId], references: [id])
  categoryId          String
  category            DimCategory     @relation(fields: [categoryId], references: [id])
  year                Int
  annualRegistrations Int
  marketSharePct      Float
  nationalRank        Int

  @@unique([manufacturerId, categoryId, year])
  @@index([year])
  @@index([categoryId])
}

model FactChargingStation {
  id                       String    @id @default(cuid())
  regionId                 String    @unique
  region                   DimRegion @relation(fields: [regionId], references: [id])
  sanctionedStations       Int
  operationalStations       Int
  fastChargersDc           Int
  slowChargersAc           Int
  highwayCorridorChargers  Int
  commissioningRatePct     Float
  scheme                   String    @default("PM_E_DRIVE")
  updatedAt                DateTime  @default(now())
}

model FactGlobalEvMarket {
  id                    String @id @default(cuid())
  region                String
  year                  Int
  powertrain            String
  vehicleType           String
  annualSalesThousands  Float
  stockThousands        Float
  evSalesSharePct       Float
  dataSource            String @default("IEA_GLOBAL_EV_DATA_EXPLORER")

  @@unique([region, year, powertrain, vehicleType])
  @@index([region])
  @@index([year])
}

model Dataset {
  id             String              @id @default(cuid())
  name           String
  description    String?
  sourceUrl      String?
  retrievalDate  DateTime            @default(now())
  fileType       String              @default("CSV")
  rowCount       Int                 @default(0)
  status         String              @default("ACTIVE")
  uploadedById   String?
  uploadedBy     User?               @relation(fields: [uploadedById], references: [id])
  importJobs     ImportJob[]
  qualityReports DataQualityReport[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ImportJob {
  id          String        @id @default(cuid())
  datasetId   String
  dataset     Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  fileName    String
  status      String        @default("COMPLETED")
  totalRows   Int           @default(0)
  validRows   Int           @default(0)
  errorRows   Int           @default(0)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  errors      ImportError[]
}

model ImportError {
  id           String    @id @default(cuid())
  importJobId  String
  importJob    ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int
  column       String?
  value        String?
  errorCode    String
  errorMessage String
  createdAt    DateTime  @default(now())
}

model DataQualityReport {
  id                String   @id @default(cuid())
  datasetId         String
  dataset           Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  completenessScore Float
  duplicateCount    Int      @default(0)
  missingValueCount Int      @default(0)
  validationScore   Float
  summary           String?
  generatedAt       DateTime @default(now())
}

model ForecastModel {
  id                  String          @id @default(cuid())
  targetMetric        String
  algorithm           String
  trainingStartYear   Int
  trainingEndYear     Int
  forecastHorizonYears Int
  mae                 Float
  rmse                Float
  mape                Float
  trainedAt           DateTime        @default(now())
  values              ForecastValue[]
}

model ForecastValue {
  id             String        @id @default(cuid())
  modelId        String
  model          ForecastModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  forecastYear   Int
  predictedValue Float
  lowerBound95   Float
  upperBound95   Float
  baselineValue  Float?
  isActual       Boolean       @default(false)
}

model PowerBIReportConfig {
  id              String   @id @default(cuid())
  reportName      String
  reportId        String
  workspaceId     String
  embedUrl        String
  targetAudience  String   @default("Executive Leadership & Analysts")
  daxMeasureCount Int      @default(18)
  lastRefreshedAt DateTime @default(now())
}
